{
  "name": "nodejs-app",
  "version": "1.0.0",
  "description": "Challenge application in Node.js",
  "main": "src/server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first --env-file=.env dist/bundle.js",
    "dev": "nodemon --dns-result-order=ipv4first --env-file=.env src/server.js",
    "clean": "rm -rf dist",
    "build": "npm run clean && esbuild src/server.js --bundle --format=esm --platform=node --target=node24 --outfile=dist/bundle.js",
    "lint": "eslint src/. --cache --fix",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --watchAll",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage",
    "validate": "npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariolargo/nodejs-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mariolargo/nodejs-app/issues"
  },
  "homepage": "https://github.com/mariolargo/nodejs-app#readme",
  "dependencies": {
    "express": "^5.2.1",
    "redis": "^6.1.0",
    "response-time": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "semantic-release-ado": "^1.4.0",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
