{
  "semi": false,
  "arrowParens": "always",
  "singleQuote": true,
  "bracketSpacing": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 120,
  "overrides": [
    {
      "files": "*.sql",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "*.hbs",
      "options": {
        "parser": "html"
      }
    }
  ]
}
